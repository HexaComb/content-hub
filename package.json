{
  "name": "content-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-updated client metrics and scheduled content on Cloudflare Workers and D1.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:web && vite",
    "build": "npm run build:web && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'",
    "check": "npm run typecheck && npm run typecheck:web && npm test && npm run test:web && npm run build && npm run test:runtime",
    "test:runtime": "node --test tests/*.integration.ts",
    "build:web": "astro build --root ./web",
    "dev:web": "astro dev --root ./web",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test:web": "node --test web/tests/format.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "astro": "^7.4.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.14",
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-beta.29",
    "miniflare": "^5.20261110.0-beta",
    "typescript": "^5.9.0",
    "vite": "^8.3.7"
  }
}

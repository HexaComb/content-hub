---
const { href = '/', subtitle = 'Content workspace' } = Astro.props;
---
<a class="app-brand" href={href} aria-label="unreel content home">
  <span class="app-logo"><img src="/images/unreelviews-logo.jpg" width="48" height="48" alt="unreelviews" /></span>
  <span class="app-brand-copy">unreel content<small>{subtitle}</small></span>
</a>

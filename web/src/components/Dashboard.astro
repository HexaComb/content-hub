---
import Workspace from './Workspace.astro';
import '../styles/plugins.css';
import '../styles/instagram-dashboard.css';
import '../styles/modal.css';
const {project=false}=Astro.props;
---
<Workspace area="client" heading={project?"Client project":"Performance overview"} description="Your results, with the context to understand them.">
<div id="status" class="admin-notice" role="status" aria-live="polite">Opening your projects…</div>
<section id="welcome" class="admin-welcome" hidden><h2>Welcome to your client portal</h2><p>See the projects shared with you, with clear month-over-month comparisons.</p><p>Open your private invitation email to get started, or sign in below if you already have access.</p><div id="clerk-sign-in" class="clerk-container"></div><p class="small">Use the email address on your invitation. Your administrator manages which projects you can access.</p></section>
<section id="project-admin" class="project-admin" hidden><a href="/admin">← All projects</a><span id="project-preview-label" class="quiet-pill">Administrator preview · Project home</span><button id="manage-invitations" class="admin-button">Invite client / Manage access</button><p id="project-preview-description">Choose a dashboard below. Client recipients see only their approved metrics.</p></section>
<div id="invitations" hidden></div>
<section id="client-page-entry" class="project-admin" hidden><a id="open-client-page-seo" hidden>Open SEO client page ↗</a><a id="open-client-page-instagram" hidden>Open Instagram client page ↗</a><span class="quiet-pill">Separate pages · One shared design</span></section>
<section id="project-plugins" class="project-plugins" aria-label="Project plugins" hidden></section>
<section id="instagram-content" class="plugin-content" aria-label="Instagram content" hidden></section>
<div id="dashboard" hidden><p id="project-breadcrumb" class="project-breadcrumb" hidden></p><section class="toolbar" aria-label="Report selection"><div class="target-control"><label for="target">CLIENT / PROJECT</label><select id="target"></select></div><div class="month-control"><label for="month">REPORTING MONTH</label><div class="month-input"><button id="previous-month" aria-label="Previous month">←</button><input type="month" id="month" min="1000-01" max="9999-12"/><button id="next-month" aria-label="Next month">→</button></div></div></section>
<section class="target-heading"><img id="theme-logo" hidden alt=""/><div class="target-avatar" aria-hidden="true" id="target-avatar">◎</div><div><p id="theme-eyebrow" hidden></p><h2 id="target-name"></h2><p id="target-detail"></p><p id="theme-tagline" hidden></p></div><span id="target-status" class="quiet-pill"></span></section>
<section id="instagram-dashboard" aria-label="Instagram dashboard" hidden></section>
<div class="theme-divider" aria-hidden="true"></div>
<div class="section-heading report-heading"><h2>Your results</h2><p id="comparison-label"></p></div>
<section id="metrics" class="metrics" aria-label="Monthly results"></section>
<details class="panel data-panel report-evidence">
  <summary>View all readings &amp; collection details</summary>
  <div class="report-evidence-body">
    <p class="muted">Changes use complete monthly readings. Missing values are never treated as zero. Partial periods are shown without a performance rating.</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Metric readings, horizontally scrollable"><table><thead><tr><th scope="col">Metric</th><th scope="col" id="current-period-heading">This month</th><th scope="col" id="previous-period-heading">Previous month</th><th scope="col">What changed</th><th scope="col">Collection details</th></tr></thead><tbody id="metric-rows"></tbody></table></div>
  </div>
</details></div>
</Workspace>
<script>import '../scripts/dashboard';</script>


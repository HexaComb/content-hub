---
// Static brand metadata only: never expose project names, identities or query tokens.
const title = 'unreel content — Your work. In perspective.';
const description = 'A private workspace for your projects, performance and progress. Presented with clarity, by unreelviews.';
const origin = 'https://content.unreelviews.com';
const image = `${origin}/images/unreel-content-og.png`;
---
<meta name="description" content={description} />
<meta name="theme-color" content="#101214" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="unreel content" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={`${origin}/`} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1731" />
<meta property="og:image:height" content="909" />
<meta property="og:image:alt" content="unreel content. Your work. In perspective. Ivory lettering and mint frames on an ink-black background." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="unreel content. Your work. In perspective." />

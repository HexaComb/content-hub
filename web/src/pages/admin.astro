---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Administrator overview">
<div id="portal"><aside class="sidebar"><a class="brand" href="/admin"><span class="brand-mark">u<span>c</span></span><span>unreel content<span class="brand-sub">THE ADMIN SPACE</span></span></a><div class="nav-section">YOUR WORKSPACE</div><a class="nav-item selected" href="/admin" aria-current="page">◫ All projects</a><a class="nav-item" href="/?view=client">↗ Client view</a><div class="sidebar-bottom"><strong>The complete picture.</strong><p>Every client and project,<br/>in one private overview.</p><span class="readonly">◉ Read-only access</span></div></aside>
<div class="workspace"><header class="topbar"><span class="breadcrumb">Administration <span>/</span> Overview</span><div class="account"><span id="identity">Checking administrator access</span><button id="logout" class="text-button" hidden>Sign out</button></div></header>
<main id="main"><section class="page-heading"><div><div class="eyebrow">YOUR AGENCY, IN VIEW</div><h1>All projects<span>.</span></h1><p>A read-only overview of every client and project in unreel content.</p></div><span class="access-pill">Super administrator</span></section>
<div id="status" class="notice" role="status" aria-live="polite">Checking administrator access…</div>
<section id="welcome" class="welcome panel" hidden><h2>Administrator sign-in</h2><p>Use your existing authorized account. Signing in does not grant administrator access.</p><div id="clerk-sign-in" class="clerk-container"></div></section>
<div id="admin-workspace" hidden><section class="panel"><h2>Workspace overview</h2><p id="summary"></p><p class="muted">Includes active, paused, completed and archived projects. Setup and changes happen through authorized MCP tools.</p></section>
<section class="panel data-panel"><div class="section-heading"><h2>Clients & projects</h2><button id="refresh" class="text-button">Refresh</button></div><div id="empty" class="notice" hidden></div><div class="table-scroll" tabindex="0" role="region" aria-label="All clients and projects"><table><thead><tr><th scope="col">Workspace</th><th scope="col">Client</th><th scope="col">Project / account</th><th scope="col">Status</th><th scope="col">Report</th></tr></thead><tbody id="project-rows"></tbody></table></div><button id="load-more" class="text-button" hidden>Load more projects</button></section>
<section id="report" hidden><section class="toolbar"><span class="quiet-pill">Administrator report view</span><div class="month-control"><label for="month">REPORTING MONTH</label><input type="month" id="month" min="1000-01" max="9999-12"/></div></section><section class="target-heading"><img id="theme-logo" hidden alt=""/><div><p id="theme-eyebrow" hidden></p><h2 id="target-name"></h2><p id="target-detail"></p><p id="theme-tagline" hidden></p></div></section><div class="theme-divider" aria-hidden="true"></div><p id="report-status" role="status" aria-live="polite"></p><div class="section-heading"><h2>At a glance</h2><p id="comparison-label"></p></div><section id="metrics" class="metrics"></section><section class="panel comparison-panel"><h2>Two months, side by side</h2><div id="comparison-chart" class="comparison-chart"></div></section><section class="panel data-panel"><div class="table-scroll" tabindex="0" role="region" aria-label="Monthly metric readings"><table><thead><tr><th scope="col">Metric</th><th scope="col">Selected month</th><th scope="col">Previous month</th><th scope="col">Change</th><th scope="col">Quality / collection date</th></tr></thead><tbody id="metric-rows"></tbody></table></div></section></section></div>
<footer><span>unreel content · Administrator workspace</span><span>Business changes stay in MCP.</span></footer></main></div></div>
<script>import '../scripts/admin';</script>
</Shell>

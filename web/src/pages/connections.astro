---
import Shell from '../layouts/Shell.astro';
import Workspace from '../components/Workspace.astro';
import '../styles/connections.css';
---
<Shell title="Connected apps">
<Workspace area="client" section="connections" heading="Connected apps" description="The apps you’ve authorized. A clear view of who can access your work.">
  <section class="connections-intro"><h2>Your workspace. Your permission.</h2><p>Review an app’s permissions or disconnect it below. These records show workspace authorization; they do not verify that an app is currently connected.</p></section>
  <p id="connections-status" class="admin-notice" role="status" aria-live="polite">Checking secure sign-in…</p>
  <div id="connections-login" class="admin-welcome" hidden><h2>Review your connections</h2><p>Sign in to see the apps you’ve authorized.</p><div id="connections-sign-in" class="clerk-container"></div></div>
  <div id="connections-list"></div>
  <div class="connections-actions"><button id="connections-more" class="admin-button" type="button" hidden>Load more connections</button><button id="connections-reload" class="admin-button" type="button" hidden>Refresh connections</button><button id="connections-signout" class="admin-button admin-button-quiet" type="button" hidden>Sign out</button></div>
</Workspace>
<script>import '../scripts/connections';</script>
</Shell>
